  "FormalooHubspotMappedFields": {
    "type": "object",
    "description": "HubSpot mappings grouped by contacts, companies, and deals. Unsupported object groups are rejected.",
    "additionalProperties": false,
    "properties": {
      "contacts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source_field": {
              "type": "string",
              "minLength": 1,
              "description": "Saved Formaloo field slug from the target form."
            },
            "destination_field": {
              "type": "object",
              "additionalProperties": true,
              "description": "Use discovery name and fieldType (not its storage type).",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Provider field identifier returned by discovery."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "booleancheckbox",
                    "radio",
                    "select",
                    "checkbox",
                    "text",
                    "number",
                    "textarea",
                    "html",
                    "file",
                    "date"
                  ],
                  "description": "Provider field type returned by discovery."
                }
              },
              "required": [
                "name",
                "type"
              ]
            }
          },
          "required": [
            "source_field",
            "destination_field"
