{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:formaloo:background-effect:1",
  "title": "Form background effect",
  "description": "Renderer authoring input for theme_config.background_effect. Filters require a background image; generators draw their own background. This does not change the API JSON-field replacement policy.",
  "x-formaloo-image-input": {
    "type": "string",
    "pattern": "^\\s*(?:http://|https://|/|data:image/)"
  },
