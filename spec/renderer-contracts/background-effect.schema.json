        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^\\s*(#[0-9a-fA-F]{3,8}|([rR][gG][bB]|[hH][sS][lL])[aA]?\\([0-9a-zA-Z\\s.,%/-]+\\))\\s*$",
              "default": "#111827"
            },
            "opacity": { "type": "number", "default": 0.4 },
            "blendMode": {
              "type": "string",
              "enum": ["normal", "multiply", "overlay"],
              "default": "normal"
            }
          }
        }
      }
    },
